{
    "name": "citricguy/postmark-webhooks-laravel",
    "description": "Allow your Laravel project to listen for webhooks sent from PostmarkApp.",
    "type": "laravel-package",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32.1",
        "orchestra/testbench": "^10.11 || ^11.2",
        "pestphp/pest": "^5.1.4",
        "phpstan/phpstan": "^2.2.13"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Citricguy\\PostmarkWebhooks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Citricguy\\PostmarkWebhooks\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Citricguy\\PostmarkWebhooks\\PostmarkWebhooksServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Josh Sommers",
            "email": "citricguy@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/pest",
        "test:coverage": "@php vendor/bin/pest --coverage",
        "test:mutate": [
            "@php vendor/bin/pest --mutate --path=src/Http --covered-only --min=100 --parallel --processes=4 --filter='AuthenticationTest|PayloadTest|ListenerTest'",
            "@php tools/check-ip-mutations.php"
        ],
        "test:lint": "@php vendor/bin/pint --test src tests tools",
        "test:analyse": "@php vendor/bin/phpstan analyse --memory-limit=2G",
        "lint": "@php vendor/bin/pint src tests tools",
        "analyse": "@test:analyse"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
